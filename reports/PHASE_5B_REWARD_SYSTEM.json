 ],
 "implemented_interfaces": {
  "M01": {
   "name": "reward signal representation",
   "implementation": "plasticity/reward.py: RewardEvent, RewardSchedule, ScriptedRewardProvider",
   "contract": "provider.step(step, time_ms, context) -> float; sums magnitudes whose delayed delivery falls in (previous_time, time_ms]; non-decreasing finite time; each event once; reset supported"
  },
  "M02": {
   "name": "reward predictor and RPE",
   "implementation": "TabularValuePredictor",
   "formula": "delta_t = r_t + gamma * V(s_next) - V(s_t); V <- clip(V + learning_rate * delta_t, -bound, bound)",
   "contract": "gamma and learning_rate in [0, 1]; None next state is terminal; non-finite rewards and updates rejected"
  },
  "M03": {
   "name": "reward and learning log schema",
   "implementation": "RewardPrediction, RewardLogger",
   "fields": [
    "step",
    "time_ms",
    "reward",
    "value",
    "next_value",
    "prediction_error",
    "state",
    "next_state"
   ]
  }
 },
